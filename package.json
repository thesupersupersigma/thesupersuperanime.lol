{
  "name": "thesupersuperanime",
  "version": "0.6.0",
  "private": true,
  "description": "Anime streaming site powered by RECONSUMET.TS",
  "license": "GPL-3.0-or-later",
  "author": "thesupersupersigma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesupersupersigma/thesupersuperanime.lol.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node --import ./server/client-ip.mjs node_modules/next/dist/bin/next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "auth:schema": "auth generate --cwd scripts --config auth-schema.ts --output ../prisma/schema.prisma"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.28",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@reconsumet/client": "0.6.0",
    "@videojs/hlsjs-video": "10.7.0",
    "@videojs/react": "10.7.0",
    "better-auth": "1.7.28",
    "hls.js": "1.7.4",
    "jassub": "2.5.38",
    "lucide-react": "1.79.0",
    "next": "16.4.6",
    "nodemailer": "10.6.1",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.2",
    "server-only": "0.0.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/three": "0.187.0",
    "auth": "1.7.28",
    "otpauth": "9.6.0",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
