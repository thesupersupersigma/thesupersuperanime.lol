# Site settings. `cp .env.example .env`, fill in the four REQUIRED values, `docker compose up -d`.
# An empty value means the default shown. Full guide: docs/self-hosting.md · login setup: docs/auth.md
# Generate secrets with: openssl rand -hex 32
#   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Use hex, not base64: base64 can contain "/" which breaks the database URLs compose builds from POSTGRES_PASSWORD.

# ---------------------------------------------------------------- required
# Password of the bundled Postgres (holds both the site's and RECONSUMET.TS's databases).
POSTGRES_PASSWORD=
# Signs sessions and encrypts 2FA secrets. At least 32 characters. Changing it signs everyone out.
BETTER_AUTH_SECRET=
# The key the site uses for the RECONSUMET.TS API (compose creates it in the API for you). At least 32 characters.
RECONSUMET_API_KEY=
# Seals stream links between the API and the relay. At least 32 characters.
RELAY_SECRET=

# ---------------------------------------------------------------- the site
# Public address of the site, no trailing slash. Also the passkey origin and the relay's allowed origin.
# Default http://localhost:3000 · example: https://anime.example.com
SITE_URL=
# Name in the header, page titles, emails and authenticator apps. Default: Anime
SITE_NAME=
# One-line description (home page, search engines). Default: none
SITE_DESCRIPTION=
# Logo image shown instead of SITE_NAME in the header/footer (https URL). Default: none
SITE_LOGO_URL=
# Discord invite shown in the footer. Default: none (link hidden) · example: https://discord.gg/abc123
DISCORD_INVITE_URL=
# A privacy-friendly analytics script (e.g. a self-hosted Umami/Plausible script URL). Default: none
ANALYTICS_SCRIPT_URL=
# AniList IDs shown on the placeholder home page, comma-separated. Default: 16498,1535,5114,113415,21,154587
HOME_ANILIST_IDS=
# Image hosts the site may resize posters and episode thumbnails from.
# Default: s4.anilist.co,cdn.myanimelist.net,img1.ak.crunchyroll.com
IMAGE_HOSTS=
# Show adult (18+) titles in search and adult tags on anime pages. Default false
SHOW_ADULT=

# ---------------------------------------------------------------- RECONSUMET.TS
# Where viewers' browsers reach the relay (video + subtitles). Default http://localhost:8081
# example: https://relay.example.com
RELAY_PUBLIC_URL=
# Image tag of the RECONSUMET.TS API + relay. Default 0.6.0
RECONSUMET_VERSION=
# Only when NOT using compose's API: its address as the site's server sees it. Compose sets http://api:8080.
# RECONSUMET_API_URL=

# ---------------------------------------------------------------- behind a reverse proxy
# Addresses/subnets of your reverse proxy or tunnel, comma-separated. Only then is the client IP taken from
# CLIENT_IP_HEADER. Default: none (the direct peer is the client). Example with the caddy profile: 172.16.0.0/12
TRUSTED_PROXIES=
# Header carrying the viewer's IP, read only from TRUSTED_PROXIES. Default X-Forwarded-For.
# Examples: CF-Connecting-IP (Cloudflare Tunnel), X-Real-IP (nginx)
CLIENT_IP_HEADER=

# ---------------------------------------------------------------- docker compose
# Where the site and relay ports are published. Default 127.0.0.1 (this machine only; fine behind a proxy on
# the host or the caddy profile). 0.0.0.0 = reachable from the network.
BIND_ADDR=
# Host ports. Defaults 3000 (site), 8081 (relay), 8025 (Mailpit, mail profile only).
SITE_PORT=
RELAY_PORT=
MAILPIT_PORT=
# Site image tag when using the prebuilt image. Default 0.6.0
SITE_VERSION=
# caddy profile only: the public names. DNS must point at this machine; ports 80 + 443 open.
# Then also set SITE_URL=https://<SITE_DOMAIN> and RELAY_PUBLIC_URL=https://<RELAY_DOMAIN>.
SITE_DOMAIN=
RELAY_DOMAIN=

# ---------------------------------------------------------------- email (SMTP)
# With SMTP set, email sign-up verifies addresses, passwords can be reset, and 2FA can send codes by email.
# Mail profile for testing: SMTP_HOST=mailpit SMTP_PORT=1025 SMTP_FROM="Anime <noreply@example.com>"
SMTP_HOST=
# Default 587 · 465 = TLS from the start
SMTP_PORT=
# true/false. Default: true when SMTP_PORT is 465, otherwise false (STARTTLS when the server offers it)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender, required with SMTP_HOST. Example: Anime <noreply@example.com>
SMTP_FROM=

# ---------------------------------------------------------------- sign-in methods (docs/auth.md)
# Every method is off until configured; with none, the site works for guests only.
# Email + password without SMTP: no verification, no password reset. Default false.
AUTH_EMAIL_ALLOW_UNVERIFIED=
# Refuse passwords found in data breaches (Have I Been Pwned; only 5 characters of a hash leave the server). Default true
AUTH_BREACHED_PASSWORD_CHECK=
# Email people when their account signs in somewhere (needs SMTP). Default false
AUTH_NEW_SIGNIN_EMAIL=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common (personal + work/school accounts), consumers, organizations, or your tenant ID. Default common
MICROSOFT_TENANT_ID=

# ---------------------------------------------------------------- running without Docker (pnpm dev / pnpm start)
# Compose sets this itself. postgres://user:password@localhost:5432/site
DATABASE_URL=
