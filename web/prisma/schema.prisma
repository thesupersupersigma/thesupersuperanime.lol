generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  discordId           String?              @unique
  discordUsername     String?
  discordAvatar       String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  watchHistory        WatchHistory[]
  watchlist           Watchlist[]
  passwordResetTokens PasswordResetToken[]
  comments            Comment[]
  commentLikes        CommentLike[]
  issues              Issue[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
}

model WatchHistory {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  animeId   Int
  episodeId String
  progress  Int      @default(0)
  duration  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, episodeId])
  @@unique([sessionId, episodeId])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  animeId   Int
  status    String   @default("Planning")
  addedAt   DateTime @default(now())

  @@unique([userId, animeId])
  @@unique([sessionId, animeId])
}

model ProviderStatus {
  id               String    @id @default(cuid())
  providerId       String    @unique
  displayName      String
  status           String    @default("unknown")
  latencyMs        Int?
  lastCheckedAt    DateTime?
  lastSuccessAt    DateTime?
  consecutiveFails Int       @default(0)
  errorMessage     String?
  updatedAt        DateTime  @updatedAt
}

model ProviderLog {
  id         String   @id @default(cuid())
  providerId String
  level      String
  message    String
  latencyMs  Int?
  createdAt  DateTime @default(now())
}

model SourceToken {
  id        String   @id @default(cuid())
  token     String   @unique
  url       String
  sessionId String
  ip        String
  quality   String
  isM3U8    Boolean  @default(true)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
}

model Comment {
  id        String    @id @default(cuid())
  animeId   Int
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  isSpoiler Boolean   @default(false)
  parentId  String?
  parent    Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   Comment[] @relation("Replies")
  likes     CommentLike[]
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([animeId])
  @@index([userId])
}

model CommentLike {
  id        String  @id @default(cuid())
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model Issue {
  id          String   @id @default(cuid())
  type        String
  description String
  animeInfo   String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  status      String   @default("open")
  createdAt   DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}