generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  discordId           String?              @unique
  discordUsername     String?
  discordAvatar       String?
  username            String?              @unique
  displayName         String?
  avatarPreset        Int?
  anilistId           Int?                 @unique
  anilistUsername     String?
  anilistToken        String?
  emailVerified       Boolean              @default(false)
  emailVerifyToken    String?              @unique
  emailVerifyExpires  DateTime?
  lastKnownLeaderboardRank Int?            // updated by cron; used to detect rank changes
  emailNotifStreak    Boolean              @default(true)
  emailNotifRanked    Boolean              @default(true)
  emailNotifNewEpisode Boolean             @default(true)
  emailNotifCompletion Boolean             @default(true)
  profilePrivate      Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  watchHistory        WatchHistory[]
  watchlist           Watchlist[]
  passwordResetTokens PasswordResetToken[]
  comments            Comment[]
  commentLikes        CommentLike[]
  issues              Issue[]
  genreVotes          GenreVote[]
  userBadges          UserBadge[]
  seasonResults       SeasonResult[]
  following           Follow[]             @relation("Following")
  followers           Follow[]             @relation("Followers")
  watchParties        WatchParty[]
  chatMessages        ChatMessage[]
  chatTimeout         ChatTimeout?
  sessions            Session[]
}

model Session {
  token     String   @id // opaque random token stored in the "user-session" cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model ChatMessage {
  id        String    @id @default(cuid())
  roomId    String    // "global" | "anime-{animeId}"
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime  @default(now())
  deletedAt DateTime? // soft delete — null = visible, non-null = deleted

  @@index([roomId, createdAt])
  @@index([userId])
}

model ChatTimeout {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  reason    String?
}

model ChatChannel {
  id          String   @id @default(cuid())
  name        String   // e.g. "general", "anime-discussion"
  description String?
  position    Int      @default(0)  // for ordering
  createdAt   DateTime @default(now())
}

model WatchParty {
  id             String   @id @default(cuid())
  roomCode       String   @unique  // 6-char uppercase alphanumeric e.g. "AB12CD"
  hostId         String?           // null = created via Discord bot (anonymous host)
  host           User?    @relation(fields: [hostId], references: [id], onDelete: SetNull)
  animeId        Int
  episodeNum     Int
  hostTimestamp  Float    @default(0)   // host's currentTime in seconds
  isPlaying      Boolean  @default(false)
  audioType      String   @default("sub")  // host's sub/dub selection, synced to guests
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  expiresAt      DateTime             // auto-expire rooms after 6 hours

  @@index([roomCode])
  @@index([expiresAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
}

model WatchHistory {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId      String
  animeId        Int
  episodeId      String
  progress       Int      @default(0)
  duration       Int      @default(0)
  watchedSeconds Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([userId, episodeId])
  @@unique([sessionId, episodeId])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  animeId   Int
  status    String   @default("Planning")
  addedAt   DateTime @default(now())
  lastNotifiedEpisode Int?     // highest episode number we've already sent a "new ep" email for
  completionNudgeSent Boolean  @default(false)

  @@unique([userId, animeId])
  @@unique([sessionId, animeId])
}

model ProviderStatus {
  id               String    @id @default(cuid())
  providerId       String    @unique
  displayName      String
  status           String    @default("unknown")
  latencyMs        Int?
  lastCheckedAt    DateTime?
  lastSuccessAt    DateTime?
  consecutiveFails Int       @default(0)
  errorMessage     String?
  updatedAt        DateTime  @updatedAt
}

model ProviderLog {
  id         String   @id @default(cuid())
  providerId String
  level      String
  message    String
  latencyMs  Int?
  createdAt  DateTime @default(now())
}

// ─── Status Page ─────────────────────────────────────────────────────────────

// Tracks outages per service for the public /status page. An incident is "open"
// while resolvedAt is null; auto-opened/closed by the status checker.
model StatusIncident {
  id           String    @id @default(cuid())
  service      String
  startedAt    DateTime  @default(now())
  resolvedAt   DateTime?
  description  String?
  autoResolved Boolean   @default(false)

  @@index([service, startedAt])
}

// Per-check history rows used to compute uptime % and the 90-bar sparkline.
model StatusCheck {
  id        String   @id @default(cuid())
  service   String
  success   Boolean
  latencyMs Int
  checkedAt DateTime @default(now())

  @@index([service, checkedAt])
}

model SourceToken {
  id        String   @id @default(cuid())
  token     String   @unique
  url       String
  sessionId String
  ip        String
  quality   String
  isM3U8    Boolean  @default(true)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
}

model Comment {
  id        String        @id @default(cuid())
  animeId   Int
  episodeId String?       // null = anime-level comment, "animeId-episodeNum" = episode comment
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  content   String
  isSpoiler Boolean       @default(false)
  parentId  String?
  parent    Comment?      @relation("Replies", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  replies   Comment[]     @relation("Replies")
  likes     CommentLike[]
  deletedAt DateTime?
  createdAt DateTime      @default(now())

  @@index([animeId, episodeId])
  @@index([userId])
}

model CommentLike {
  id        String  @id @default(cuid())
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model Issue {
  id          String   @id @default(cuid())
  // Valid values: "Video not playing" | "Missing episode" | "Wrong subtitles" | "Site bug" | "Suggestion" | "Other"
  type        String
  description String
  animeInfo   String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Status values: "open" | "in_progress" | "fixed" | "wont_fix" | "duplicate" | "resolved" (legacy)
  status      String   @default("open")
  priority    Int      @default(0)
  githubUrl   String?
  createdAt   DateTime @default(now())

  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model GenreVote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  animeId   Int
  genre     String
  createdAt DateTime @default(now())

  @@unique([userId, animeId, genre])
  @@index([animeId, genre])
  @@index([genre])
}

model Announcement {
  id        String   @id @default(cuid())
  message   String
  type      String   @default("info")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Badge System ────────────────────────────────────────────────────────────

model Badge {
  id          String      @id @default(cuid())
  slug        String      @unique  // e.g. "first-episode", "top-10", "admin"
  name        String               // e.g. "First Step"
  description String               // e.g. "Watched your first episode"
  icon        String               // emoji or image URL
  // Rarity controls display order on profiles — rarer shows first
  // Values: "common" | "rare" | "epic" | "legendary"
  rarity      String      @default("common")
  rarityOrder Int         @default(0) // 0=common, 1=rare, 2=epic, 3=legendary — for sorting
  // Who can grant this badge
  // Values: "auto" | "admin" | "owner"
  grantedBy   String      @default("auto")
  // Stackable badges can be granted multiple times (e.g. weekly champion)
  stackable   Boolean     @default(false)
  // Hidden badges don't show in the badge list until earned
  hidden      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  userBadges  UserBadge[]
}

model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeSlug   String
  badge       Badge    @relation(fields: [badgeSlug], references: [slug], onDelete: Cascade)
  grantedAt   DateTime @default(now())
  // "auto" for system-granted, or userId of the admin/owner who granted it manually
  grantedBy   String   @default("auto")
  // For stackable badges, stores context e.g. "Season 1", "Week of 2026-06-17"
  context     String?

  @@unique([userId, badgeSlug, context]) // enforced for non-stackable; stackable badges bypass this in app logic
  @@index([userId])
  @@index([badgeSlug])
}

// Cached AniList genres per anime, populated when a user completes an anime.
// Used by the genre auto-badge logic to avoid hitting AniList synchronously.
model GenreCache {
  animeId   Int      @id
  genres    String[]
  updatedAt DateTime @updatedAt
}

// Records that a user watched a given anime while it was still airing
// (AniList status RELEASING). Drives the "airing watcher" badges.
model AiringWatch {
  id      String @id @default(cuid())
  userId  String
  animeId Int

  @@unique([userId, animeId])
}

// Per-user daily watch streak tracking. Drives the streak badges.
model WatchStreak {
  userId        String    @id
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastWatchDate DateTime?
}

// ─── Changelog System ────────────────────────────────────────────────────────

model Changelog {
  id          String   @id @default(cuid())
  version     String   // e.g. "1.4.0"
  title       String
  body        String   // markdown-ish plain text
  major       Boolean  @default(false) // major releases trigger the "what's new" modal
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([publishedAt(sort: Desc)])
}

// ─── Season System ───────────────────────────────────────────────────────────

model Season {
  id          String         @id @default(cuid())
  number      Int            @unique  // Season 1, Season 2, etc.
  name        String?                 // Optional custom name e.g. "Summer 2026"
  startedAt   DateTime
  endedAt     DateTime?               // null = currently active season
  createdAt   DateTime       @default(now())
  results     SeasonResult[]
}

model SeasonResult {
  id             String   @id @default(cuid())
  seasonId       String
  season         Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank           Int      // Final rank at end of season
  minutesWatched Int      // Total minutes watched during the season
  episodesWatched Int     // Total episodes watched during the season
  createdAt      DateTime @default(now())

  @@unique([seasonId, userId])
  @@unique([seasonId, rank])
  @@index([seasonId])
  @@index([userId])
}