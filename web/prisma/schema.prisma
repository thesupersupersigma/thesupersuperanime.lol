generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WatchHistory {
  id        String   @id @default(cuid())
  sessionId String
  animeId   Int
  episodeId String
  progress  Int      @default(0)
  duration  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([sessionId, episodeId])
}

model Watchlist {
  id        String   @id @default(cuid())
  sessionId String
  animeId   Int
  addedAt   DateTime @default(now())

  @@unique([sessionId, animeId])
}

model ProviderStatus {
  id               String    @id @default(cuid())
  providerId       String    @unique
  displayName      String
  status           String    @default("unknown") // "healthy" | "degraded" | "broken" | "unknown"
  latencyMs        Int?
  lastCheckedAt    DateTime?
  lastSuccessAt    DateTime?
  consecutiveFails Int       @default(0)
  errorMessage     String?
  updatedAt        DateTime  @updatedAt
}

model ProviderLog {
  id         String   @id @default(cuid())
  providerId String
  level      String   // "info" | "warn" | "error" | "success"
  message    String
  latencyMs  Int?
  createdAt  DateTime @default(now())
}

model SourceToken {
  id        String   @id @default(cuid())
  token     String   @unique
  url       String   // AES encrypted at rest using ENCRYPTION_SECRET env var
  sessionId String
  ip        String
  quality   String
  isM3U8    Boolean  @default(true)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
}
