# ─── Core ────────────────────────────────────────────────────────────────────

# Neon PostgreSQL connection string
DATABASE_URL=

# Full site URL, no trailing slash (e.g. https://www.thesupersuperanime.lol)
# Used for CORS, OAuth redirects, email links, and OG metadata
NEXT_PUBLIC_SITE_URL=

# ─── Auth & Security ─────────────────────────────────────────────────────────

# HMAC-SHA256 signing key for HLS proxy tokens — any random 32+ char string
TOKEN_SECRET=

# AES-256-CBC encryption key for stream URLs in proxy tokens — any random 32+ char string
ENCRYPTION_SECRET=

# HMAC-SHA256 signing key for the `user-session` cookie. The Edge proxy can't
# reach Postgres, so it verifies this signature instead of just checking that
# the cookie exists. OPTIONAL — falls back to TOKEN_SECRET when unset.
# Changing it invalidates every signed-in session (they sign in again).
SESSION_COOKIE_SECRET=

# Bearer token required for all /api/cron/* routes
# Set the same value in GitHub Actions secrets as CRON_SECRET
CRON_SECRET=

# Separate secret for the AniList auto-sync cron (x-cron-secret header)
# Set the same value in GitHub Actions secrets as ANILIST_SYNC_SECRET
ANILIST_SYNC_SECRET=

# Verifies X-Hub-Signature-256 on GitHub push webhook events
# Set the same value in your GitHub repo's webhook settings
GITHUB_WEBHOOK_SECRET=

# Vercel deployment protection bypass token (used in Discord OAuth callback)
VERCEL_BYPASS_SECRET=

# ─── Site Access Gates ────────────────────────────────────────────────────────

# Password shown on the site-wide lock screen before users can access anything
SITE_PASSWORD=

# Set to "off" to disable the site password gate (default: on)
SITE_PASSWORD_GATE=

# Set to "off" to disable the Discord/email verification gate (default: on)
DISCORD_GATE=

# Set to "off" to allow anonymous browsing when DISCORD_GATE=on (default: on)
MASTER_GATE=

# ─── Admin ───────────────────────────────────────────────────────────────────

# Discord user IDs with admin access — add more as ADMIN_3, ADMIN_4, etc.
# These are the sole admin authorization mechanism (checked by isAdmin())
ADMIN_1=
ADMIN_2=

# Discord user ID of the site owner — gets the Owner badge (supersedes Admin badge)
OWNER_DISCORD_ID=

# Unused — kept for legacy compatibility
ADMIN_PASSWORD=

# ─── Discord ─────────────────────────────────────────────────────────────────

# Discord OAuth2 app credentials (from discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bot token for DMs, slash commands, and server management
DISCORD_BOT_TOKEN=

# Your Discord server ID (for auto-adding users on login)
DISCORD_GUILD_ID=

# App public key from Discord Developer Portal → General Information
# Required for slash command signature verification (/api/discord/interactions)
DISCORD_PUBLIC_KEY=

# Application ID from Discord Developer Portal
# Required for registering slash commands (scripts/register-discord-commands.mjs)
DISCORD_APP_ID=

# Discord user ID to receive new signup DM alerts
DISCORD_ALERT_USER_ID=

# Public invite link shown by PromoBanner. Prefer a PERMANENT invite code over a
# vanity slug: a vanity URL is only held while the server keeps Boost Level 3,
# and Discord releases the slug for anyone to claim if boosts lapse.
# Defaults to the current vanity link when unset.
NEXT_PUBLIC_DISCORD_INVITE_URL=

# ─── Discord Webhooks ────────────────────────────────────────────────────────

# Provider health failure/recovery alerts (postToDiscord in src/lib/discord.ts).
# Consumed by sendProviderAlert / sendProviderRecovery. Without it BOTH early-
# return, so the 3-consecutive-failure alarm is silently disabled -- it was
# missing from this file entirely while the comment below sat on the wrong
# variable, so an operator provisioning from here believed it was configured.
DISCORD_WEBHOOK_URL=

# "New Discord Link" / admin security embeds from the OAuth callback route.
# NOT provider health alerts -- that's DISCORD_WEBHOOK_URL above.
DISCORD_ALERT_WEBHOOK_URL=

# #new-episodes channel — posts when a new episode airs for watchlisted anime
DISCORD_NEW_EPISODES_WEBHOOK_URL=

# #badges channel — posts when a user earns a notable milestone badge
DISCORD_BADGES_WEBHOOK_URL=

# #updates channel — posts when a changelog entry is published by an admin
DISCORD_UPDATES_WEBHOOK_URL=

# ─── Video & Streaming ───────────────────────────────────────────────────────

# Base URL of the self-hosted Anivexa API on Oracle VM
# e.g. http://64.181.222.197:4000
# Anivexia is now legacy because i changed scrapers to my own called RECONSUMET.TS (you should check it out its cool trust)

SCRAPER_API_URL=

# HTTPS URL of the tsss-proxy on Oracle VM (served via nginx + Let's Encrypt)
# e.g. https://nginx.thesupersuperanime.lol:8443
PROXY_VM_URL=

# ─── Email ───────────────────────────────────────────────────────────────────

# Resend API key for transactional email (verification, password reset, nudge emails)
RESEND_API_KEY=

# ─── AniList OAuth ───────────────────────────────────────────────────────────

# AniList OAuth app credentials (from anilist.co/settings/developer)
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# Same as ANILIST_CLIENT_ID — exposed to the browser for the OAuth connect flow
NEXT_PUBLIC_ANILIST_CLIENT_ID=

# ─── GitHub Integration ──────────────────────────────────────────────────────

# Personal access token for syncing site issues to a GitHub repo (needs repo scope)
GITHUB_PAT=

# Target repo for issue sync in owner/repo format
# e.g. thesupersupersigma/issues-thesupersuperanime.lol
GITHUB_ISSUES_REPO=

# ─── Feature Flags ───────────────────────────────────────────────────────────

# Set to "true" to enable HilltopAds scripts in the layout (default: false)
NEXT_PUBLIC_ADS_ENABLED=false

# ─── Legacy / Unused ─────────────────────────────────────────────────────────
# These are consumed by the legacy provider registry in src/lib/core-dist/
# Only relevant to the admin health-check dashboard, not the live video pipeline

ANIVEXA_API_URL=
SCRAPER_SERVICE_URL=
SERVICE_SECRET=
MIRURO_API_URL=
MIRURO_API_URL_2=
MIRURO_API_URL_3=
MIRURO_API_KEY=
BETTERSCRAPER_URL=
BETTERSCRAPER_API_KEY=
